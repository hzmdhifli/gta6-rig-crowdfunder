# Server Port
PORT=3000

# Lemon Squeezy Webhook Signing Secret
# Found in: Lemon Squeezy Dashboard -> Settings -> Webhooks -> [Your Webhook] -> Signing Secret
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Campaign Goal (in USD cents, e.g., 500000 = $5,000.00)
DONATION_GOAL_CENTS=500000

